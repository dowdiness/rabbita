import {
  "moonbitlang/async/js_async",
  "moonbitlang/core/json",
}

// Imports are used only by JS declarations and tests.

warnings = "-unused_package-implicit_impl_as_method"

import {
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
} for "test"

options(
  targets: { "*": [ "js" ] },
)
