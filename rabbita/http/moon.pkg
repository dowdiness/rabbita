import {
  "moonbit-community/rabbita/cmd",
  "moonbit-community/rabbita/dom",
  "moonbit-community/rabbita/url",
  "moonbitlang/async",
  "moonbitlang/async/http" @async_http,
  "moonbitlang/async/io",
  "moonbitlang/core/json",
}

import {
  "moonbit-community/rabbita/internal/key",
} for "wbtest"

warnings = "-unused_package"

supported_targets = "js+native+wasm"

options(
  targets: { "http_wbtest.mbt": [ "js" ] },
)
